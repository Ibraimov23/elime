@model ElimeProject.ViewModels.DishesViewModel

@{
    ViewData["Title"] = "Index";
}
<div class="dish" id="dish">
    <header class="container">
        <nav class="navbar navbar-light p-0 mt-3">
            <button class="navbar-toggler border border-dark" type="button" data-toggle="collapse" data-target="#navbarToggleExternalContent" aria-controls="navbarToggleExternalContent" aria-expanded="false" aria-label="Toggle navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </nav>
        <ul class="navbar-nav">
            <li class="nav-item m-auto">
                <img style="width: 140px; height: 140px" src="~/images/embedded/logo.svg" alt="">
            </li>
            <li class="nav-item m-auto">
                <h4 class="dish-welcomText">Добро пожаловать</h4>
            </li>
        </ul>
    </header>
    <div class="dish-container">
        <hr class="dish-line" />
        <div class="container">
            <div class="row">
                <div class="col-2">
                    <a class="soc_link" href="#" target="_blank">
                        <img style="width: 40px; height: 40px" src="~/images/embedded/wifi.svg" alt="wifi">
                    </a>
                </div>
                <div class="col-2">
                    <h5 class="dish-wifiText">elimewifi</h5>
                </div>
                <div class="w-100 mt-2"></div>
                <div class="col-2">
                    <a class="soc_link" href="https://www.instagram.com/elimeservice/?utm_medium=copy_link" target="_blank">
                        <img style="width: 30px; height: 30px" src="~/images/embedded/insta.svg" alt="insta">
                    </a>
                </div>
                <div class="col-2">
                    <h5 class="dish-instaText">@ViewData["Instagram"]</h5>
                </div>
            </div>
        </div>
        <hr class="dish-line" />
    </div>
    <div class="dish-container">
        <div class="dish-searchMenu class container" id="result">
            <div class="row">
                <div class="col-2 text-left">
                    <a class="dish-drink" href="/drinkes">
                        <img src="~/images/embedded/drink.svg" alt="" style="height: 26px; width: 30px;">
                    </a>
                </div>
                <div class="col">
                    <form method="get" class="form-search">
                        <div class="search">
                            <span>
                                <img src="images/embedded/search.png" alt="">
                            </span>
                            <input class="form-control" id="search" type="search" placeholder="поиск" aria-label="Search" style="height: 36px;" autocomplete="off">
                        </div>
                    </form>
                </div>
                <div class="col-2 text-right">
                    <a class="dish-basket" href="/baskets">
                        <img src="images/embedded/basket.svg" alt="" style="height: 30px; width: 29px;">
                        <p id="count"></p>
                    </a>
                </div>
            </div>
        </div>

        <div class="dish-foodCategories container">
            @foreach (DishCategory category in Model.DishCategories)
            {
            <button class="dish-criteria-@category.Id" style="height: 30px; padding-left: 15px; padding-right: 15px; color: black;" onclick="filter('@category.Id')">@category.Name</button>
            }
        </div>
        <div class="dish-menu mt-1 container">
            <div class="row">
                @foreach (Dish dish in Model.Dishes)
                {
                <div class="col-lg-4 col-md-6 pb-4 dish-kk" id="@dish.Id">
                    <div class="card dish-card p-0" style="height: 156px;width: auto;">
                        <div class="row">
                            <div class="col-5">
                                <div class="img-wrapper">
                                    <img class="card-img-top" src="~/images/dishes/@dish.ImageName" alt="" style="width: 100px; height: 93px;">
                                    <img src="/images/embedded/arrow.png" onclick="showImgLarge(this);" alt="" class="pop-up-button" />
                                </div>
                                <div class="dish-price">
                                    <h6>@String.Concat(dish.Price.ToString(), "₽")</h6>
                                </div>
                            </div>
                            <div class="col-7 p-0">
                                <div class="dish-card-body">
                                    <h5 class="card-title">@dish.Name</h5>
                                    <p class="card-text">@dish.Description</p>
                                </div>
                                <div id="button-center-@dish.Id">
                                    <button class="create-btn" id="create-btn-@dish.Id" onclick="create(@dish.Id, '@dish.Name', '@dish.NutritValue', '@dish.Description', '@dish.DishCategoryId', @dish.Price, '@dish.ImageName',@dish.Weight)">в корзину</button>
                                    <button class="created-btn" id="created-btn-@dish.Id">
                                        <img class="minus" src="~/images/embedded/minus.png" onclick="minus(@dish.Id)" style="width: 15px; height: 15px; margin: auto;" />
                                        <span class="number" id="number-@dish.Id" style="color: black;">1</span>
                                        <img class="plus" src="~/images/embedded/plus.png" onclick="plus(@dish.Id)" style="width: 15px; height: 15px; margin: auto;" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>
    </div>
    <div id="alarm">
        <img src="/images/embedded/ofnik.png" alt="">
    </div>
    <div id="popUpImgBlock" style="display: none;">
        <img src="images/embedded/close.png" alt="" id="closePopUp">
        <img src="" alt="" class="card-img-top" id="popUpImg">
    </div>
</div>
<script src="~/js/dishes/dish.js"></script>